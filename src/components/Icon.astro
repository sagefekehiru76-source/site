---
// Lucide (UI) and Simple Icons (social brands), inlined at build time — no runtime JS.
import { ArrowRight, ArrowUpRight, Mail, Phone, MapPin, Upload, Plus, Menu } from 'lucide-static';
import { siInstagram, siYoutube, siX } from 'simple-icons';

const lucide = { 'arrow-right': ArrowRight, 'arrow-up-right': ArrowUpRight, mail: Mail, phone: Phone, 'map-pin': MapPin, upload: Upload, plus: Plus, menu: Menu };
const brands = { instagram: siInstagram, youtube: siYoutube, x: siX };

interface Props {
  name: keyof typeof lucide | keyof typeof brands;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;

let svg: string;
if (name in brands) {
  const icon = brands[name as keyof typeof brands];
  svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor" aria-hidden="true" focusable="false" class="${cls}"><path d="${icon.path}"/></svg>`;
} else {
  svg = lucide[name as keyof typeof lucide]
    .replace(/class="[^"]*"/, `class="${cls}" aria-hidden="true" focusable="false"`)
    .replace(/width="24"/, `width="${size}"`)
    .replace(/height="24"/, `height="${size}"`)
    .replace(/stroke-width="2"/, 'stroke-width="1.75"');
}
---
<Fragment set:html={svg} />
