---
import T from './T.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang).workshop;
---
<section id="workshop" class="py-20 sm:py-28" aria-labelledby="workshop-title">
  <div class="wrap">
    <div class="relative" data-reveal>
      <img
        src="/images/workshop-sewing.jpg"
        alt={d.imgMain}
        width="1920"
        height="1080"
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] h-auto w-full rounded-xl object-cover sm:aspect-[16/9]"
      />
      <div class="relative -mt-12 ml-4 mr-4 rounded-lg bg-cream p-6 sm:absolute sm:bottom-0 sm:left-0 sm:m-0 sm:max-w-md sm:rounded-none sm:rounded-tr-xl sm:p-8">
        <p class="eyebrow">{d.eyebrow}</p>
        <h2 id="workshop-title" class="mt-3 text-4xl sm:text-5xl">{d.title}</h2>
      </div>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-12">
      <div class="space-y-5 text-lg lg:col-span-6" data-reveal>
        {d.body.map((p) => <p><T v={p} /></p>)}
      </div>

      <div class="lg:col-span-5 lg:col-start-8" data-reveal>
        <h3 class="text-2xl">{d.materialsTitle}</h3>
        <dl class="mt-5 divide-y divide-dashed divide-ink/25 border-y border-dashed border-ink/25">
          {d.materials.map((m) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
              <dt class="font-mono text-xs uppercase tracking-wider text-ink-soft pt-1">{m.name}</dt>
              <dd><T v={m.text} /></dd>
            </div>
          ))}
        </dl>
        <div class="mt-8 grid grid-cols-2 gap-4">
          <img src="/images/tape-rolls.jpg" alt={d.imgRolls} width="900" height="900" loading="lazy" decoding="async" class="aspect-square h-auto w-full rounded-lg object-cover" />
          <img src="/images/thread-spools.jpg" alt={d.imgThread} width="900" height="900" loading="lazy" decoding="async" class="aspect-square h-auto w-full translate-y-6 rounded-lg object-cover" />
        </div>
      </div>
    </div>
  </div>
</section>
