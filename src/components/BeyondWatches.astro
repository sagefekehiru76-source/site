---
import { img } from '../lib/asset';
import T from './T.astro';
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang).beyond;
const [camera, bag, guitar] = d.items;
---
<section id="beyond" class="bg-navy py-20 text-cream sm:py-28" aria-labelledby="beyond-title">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-5">
        <p class="eyebrow !text-mustard">{d.eyebrow}</p>
        <h2 id="beyond-title" class="mt-4 text-4xl sm:text-5xl">{d.title}</h2>
      </div>
      <p class="text-lg text-cream/80 lg:col-span-6 lg:col-start-7 lg:self-end">{d.lead}</p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:gap-8">
      <!-- Camera: tall portrait -->
      <article class="lg:col-span-5" data-reveal>
        <img src={img(camera.img)} alt={camera.imgAlt} width="1200" height="1500" loading="lazy" decoding="async" class="aspect-[4/5] h-auto w-full rounded-xl object-cover" />
        <h3 class="mt-5 text-3xl">{camera.name}</h3>
        <p class="mt-2 text-cream/80">{camera.text}</p>
        {camera.details && <p class="mt-3 text-sm"><T v={camera.details} /></p>}
      </article>

      <div class="grid gap-10 lg:col-span-7 lg:gap-8">
        <!-- Guitar: wide landscape -->
        <article data-reveal>
          <img src={img(guitar.img)} alt={guitar.imgAlt} width="1500" height="1000" loading="lazy" decoding="async" class="aspect-[3/2] h-auto w-full rounded-xl object-cover" />
          <h3 class="mt-5 text-3xl">{guitar.name}</h3>
          <p class="mt-2 text-cream/80">{guitar.text}</p>
          {guitar.details && <p class="mt-3 text-sm"><T v={guitar.details} /></p>}
        </article>

        <!-- Bag: square photo next to its text -->
        <article class="grid gap-5 sm:grid-cols-2 sm:items-center sm:gap-8" data-reveal>
          <img src={img(bag.img)} alt={bag.imgAlt} width="1000" height="1000" loading="lazy" decoding="async" class="aspect-square h-auto w-full rounded-xl object-cover" />
          <div>
            <h3 class="text-3xl">{bag.name}</h3>
            <p class="mt-2 text-cream/80">{bag.text}</p>
            {bag.details && <p class="mt-3 text-sm"><T v={bag.details} /></p>}
            <a href="#quote" class="mt-6 inline-flex items-center gap-2 font-medium text-mustard hover:text-cream">
              {d.cta}<Icon name="arrow-right" size={18} />
            </a>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
