---
import T from './T.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang).process;
---
<section id="process" class="bg-paper py-20 sm:py-28" aria-labelledby="process-title">
  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">{d.eyebrow}</p>
        <h2 id="process-title" class="mt-4 text-4xl sm:text-5xl">{d.title}</h2>
        <p class="mt-6 max-w-2xl text-lg text-ink-soft">{d.lead}</p>
      </div>
      <div class="lg:col-span-5" data-reveal>
        <img
          src="/images/process-samples.jpg"
          alt={d.imgAlt}
          width="1500"
          height="1000"
          loading="lazy"
          decoding="async"
          class="aspect-[3/2] h-auto w-full rounded-xl object-cover"
        />
      </div>
    </div>

    <!-- Steps: a strip of tape with five stitched stops on it -->
    <ol class="relative mt-16 grid gap-10 md:grid-cols-5 md:gap-6">
      <span aria-hidden="true" class="tape-thin absolute left-[1.15rem] top-0 h-full w-1.5 md:left-0 md:top-[1.15rem] md:h-1.5 md:w-full"></span>
      {d.steps.map((s, i) => (
        <li class="relative pl-14 md:pl-0 md:pt-14" data-reveal>
          <span class="absolute left-0 top-0 grid h-10 w-10 place-items-center rounded-full border-2 border-dashed border-terra bg-paper font-mono text-sm font-medium text-terra">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="text-2xl">{s.title}</h3>
          <p class="mt-2 text-[0.97rem] text-ink-soft">{s.text}</p>
        </li>
      ))}
    </ol>

    <!-- Facts card styled like a sewn-in label -->
    <div class="mt-16 grid gap-6 rounded-xl border border-line bg-cream p-6 sm:p-8 lg:grid-cols-12 lg:items-center" data-reveal>
      <div class="lg:col-span-4">
        <h3 class="text-2xl">{d.factsTitle}</h3>
        <p class="mt-2 text-sm text-ink-soft">{d.factsNote}</p>
      </div>
      <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:col-span-8">
        {d.facts.map((f) => (
          <div class="border-t border-dashed border-ink/25 pt-3">
            <dt class="font-mono text-xs uppercase tracking-wider text-ink-soft">{f.label}</dt>
            <dd class="mt-1 text-lg"><T v={f.value} /></dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
