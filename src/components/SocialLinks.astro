---
import Icon from './Icon.astro';
import { socials } from '../config';
interface Props { class?: string; size?: number; showNames?: boolean }
const { class: cls = '', size = 20, showNames = false } = Astro.props;
---
<ul class:list={['flex items-center', showNames ? 'flex-col items-start gap-3' : 'gap-1', cls]}>
  {socials.map((s) => (
    <li>
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={showNames ? undefined : `LaunchOnNato on ${s.name}`}
        class:list={[
          'inline-flex items-center gap-2.5 rounded-full transition-colors hover:text-terra',
          showNames ? '' : 'p-2',
        ]}
      >
        <Icon name={s.icon} size={size} />
        {showNames && <span>{s.name} <span class="text-current/60">@launchonnato</span></span>}
      </a>
    </li>
  ))}
</ul>
