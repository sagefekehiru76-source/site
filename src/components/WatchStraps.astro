---
import T from './T.astro';
import TapeDivider from './TapeDivider.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang).straps;
const keys = ['widths', 'thickness', 'length', 'material', 'hardware', 'logo'] as const;
---
<section id="straps" class="weave py-20 sm:py-28" aria-labelledby="straps-title">
  <div class="wrap">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
      <div class="max-w-2xl">
        <p class="eyebrow">{d.eyebrow}</p>
        <h2 id="straps-title" class="mt-4 text-4xl sm:text-5xl">{d.title}</h2>
      </div>
      <p class="max-w-md text-lg text-ink-soft">{d.lead}</p>
    </div>

    <!-- Width ruler: actual-scale-ish bars for 18 / 20 / 22 / 24 mm -->
    <div class="mt-10 flex flex-wrap items-end gap-x-5 gap-y-4 sm:gap-x-8" aria-hidden="true" data-reveal>
      {[18, 20, 22, 24].map((w) => (
        <div class="flex flex-col items-center gap-2">
          <span class="tape block w-16 rounded-[2px] sm:w-24" style={`height:${w * 0.1}rem`}></span>
          <span class="font-mono text-xs">{w} mm</span>
        </div>
      ))}
    </div>

    <div class="mt-14 space-y-16 sm:space-y-20">
      {d.types.map((s, i) => (
        <article id={`strap-${s.id}`} class="grid gap-8 lg:grid-cols-12 lg:items-start lg:gap-12" data-reveal>
          <div class:list={['lg:col-span-6', i % 2 === 1 && 'lg:order-2']}>
            <img
              src={`/images/${s.img}`}
              alt={s.imgAlt}
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] h-auto w-full rounded-xl object-cover"
            />
          </div>
          <div class="lg:col-span-6">
            <p class="font-mono text-xs text-ink-soft">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-1 text-3xl sm:text-4xl">{s.name}</h3>
            <p class="mt-3 text-ink-soft">{s.text}</p>
            <table class="mt-6 w-full border-collapse overflow-hidden rounded-lg bg-paper text-left text-[0.95rem]">
              <caption class="sr-only">{s.name} — specifications</caption>
              <tbody>
                {keys.map((k) => (
                  <tr class="border-b border-line last:border-b-0">
                    <th scope="row" class="w-[38%] px-4 py-3 align-top font-mono text-xs font-medium uppercase tracking-wider text-ink-soft">{d.specLabels[k]}</th>
                    <td class="px-4 py-3 align-top"><T v={s.specs[k]} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<TapeDivider />
