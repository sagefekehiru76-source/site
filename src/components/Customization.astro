---
import { img } from '../lib/asset';
import T from './T.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang).custom;

const finishes: Record<string, string> = {
  polished: 'radial-gradient(circle at 30% 25%, #ffffff 0 12%, #d9dde2 30%, #9aa1aa 62%, #eef0f2 80%, #8a919a 100%)',
  brushed: 'repeating-linear-gradient(100deg, rgb(255 255 255 / .25) 0 1px, transparent 1px 3px), linear-gradient(135deg, #c9ccd0, #a7acb2 50%, #c3c6ca)',
  pvd: 'radial-gradient(circle at 30% 25%, #6b6e74 0 8%, #2b2d31 40%, #121315 75%, #34363b 100%)',
};
---
<section id="customization" class="py-20 sm:py-28" aria-labelledby="custom-title">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 id="custom-title" class="mt-4 text-4xl sm:text-5xl">{d.title}</h2>
      <p class="mt-6 text-lg text-ink-soft">{d.lead}</p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-24" data-reveal>
          <img
            src={img("macro-logo-stitch.jpg")}
            alt={d.macroAlt}
            width="1500"
            height="1000"
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] h-auto w-full rounded-xl object-cover lg:aspect-[4/5]"
          />
        </div>
      </div>

      <ul class="divide-y divide-line border-y border-line lg:col-span-7">
        {d.methods.map((m, i) => (
          <li class="grid grid-cols-[5.5rem_1fr] gap-5 py-7 sm:grid-cols-[8rem_1fr] sm:gap-7" data-reveal>
            <img
              src={img(m.img)}
              alt=""
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              class="aspect-square h-auto w-full rounded-lg object-cover"
            />
            <div>
              <p class="font-mono text-xs text-ink-soft">{String(i + 1).padStart(2, '0')} / {String(d.methods.length).padStart(2, '0')}</p>
              <h3 class="mt-1 text-2xl sm:text-[1.7rem]">{m.name}</h3>
              <p class="mt-2 text-ink-soft">{m.text}</p>
              <p class="mt-3 text-sm"><span class="font-mono text-xs uppercase tracking-wider text-terra">{d.bestFor}:</span> {m.best}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-20 grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <h3 class="text-3xl">{d.coloursTitle}</h3>
        <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {d.colours.map((c) => (
            <li>
              <span
                class="block h-14 rounded-sm shadow-[inset_0_0_0_1px_rgb(0_0_0/0.08)]"
                style={`background-color:${c.hex};background-image:repeating-linear-gradient(90deg,rgb(0 0 0/.09) 0 1px,transparent 1px 4px),repeating-linear-gradient(0deg,rgb(255 255 255/.08) 0 1px,transparent 1px 3px)`}
                aria-hidden="true"
              ></span>
              <span class="mt-2 block text-sm">{c.name}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm"><T v={d.coloursNote} /></p>
      </div>

      <div class="lg:col-span-5" data-reveal>
        <h3 class="text-3xl">{d.hardwareTitle}</h3>
        <ul class="mt-6 space-y-5">
          {d.hardware.map((h) => (
            <li class="flex items-start gap-4">
              <span class="mt-0.5 h-12 w-12 shrink-0 rounded-full shadow-[inset_0_0_0_1px_rgb(0_0_0/0.15)]" style={`background:${finishes[h.finish]}`} aria-hidden="true"></span>
              <div>
                <p class="font-semibold">{h.name}</p>
                <p class="text-sm text-ink-soft"><T v={h.text} /></p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
