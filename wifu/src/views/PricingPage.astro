---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/home/Faq.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import { appHref } from '../lib/links';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.pricingPage;
---
<Base lang={lang} title={d.meta.pricing.title} description={d.meta.pricing.description}>
  <Header lang={lang} />
  <main id="main">
    <section class="wrap pt-14 pb-12 text-center sm:pt-20">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="mt-3 text-5xl sm:text-6xl">{p.title}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-soft"><T v={p.lead} /></p>
    </section>

    <section class="wrap grid max-w-4xl gap-6 pb-10 md:grid-cols-2">
      {p.plans.map((plan, i) => (
        <article class:list={['relative flex flex-col rounded-2xl border p-7 sm:p-9', i === 1 ? 'border-ink bg-ink text-paper [&_.todo]:border-paper/50 [&_.todo]:bg-paper/5 [&_.todo]:text-paper/85' : 'border-line bg-card']}>
          {i === 1 && <span class="absolute -top-3 left-7 rounded-full bg-terra px-3 py-1 text-xs font-medium text-paper">{p.popular}</span>}
          <h2 class="text-3xl">{plan.name}</h2>
          <p class="mt-4 text-3xl"><T v={plan.price} /></p>
          {plan.period && <p class:list={['mt-2 text-sm', i === 1 ? 'text-paper/70' : 'text-ink-soft']}><T v={plan.period} /></p>}
          <p class:list={['mt-4', i === 1 ? 'text-paper/80' : 'text-ink-soft']}><T v={plan.text} /></p>
          <ul class="mt-6 flex-1 space-y-3">
            {plan.features.map((f) => <li class="flex items-start gap-3"><Icon name="check" size={18} class={`mt-1 shrink-0 ${i === 1 ? 'text-terra-light' : 'text-sage-dark'}`} /><span><T v={f} /></span></li>)}
          </ul>
          <a href={appHref(lang)} class:list={['btn mt-8', i === 1 ? 'btn-light' : 'btn-primary']}>{plan.cta}</a>
        </article>
      ))}
    </section>
    <p class="wrap text-center text-sm text-ink-soft">{p.note}</p>

    <section class="wrap max-w-4xl py-16">
      <h2 class="h2">{p.compareTitle}</h2>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b border-ink/40">
              {p.compareHead.map((h, i) => <th scope="col" class:list={['py-3 font-medium', i > 0 && "w-20 text-center sm:w-28"]}>{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {p.compare.map(([label, free, premium]) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-4 pr-4 font-normal">{label}</th>
                {[free, premium].map((v) => (
                  <td class="py-4 text-center">
                    {v === true ? <><Icon name="check" size={20} class="mx-auto text-sage-dark" /><span class="sr-only">✓</span></>
                      : v === false ? <span class="text-ink-soft/60" aria-label="—">—</span>
                      : <T v={String(v)} />}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <Faq lang={lang} id="pricing-faq" eyebrow={p.eyebrow} title={p.faqTitle} items={p.faq} />
  </main>
  <Footer lang={lang} />
</Base>
