---
// Simple text page: legal stubs, thank-you page, 404.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import T from '../components/T.astro';
import { brand, owners } from '../config';
import { localePath, t, type Lang } from '../i18n';
interface Props { lang: Lang; kind: 'privacy' | 'terms' | 'thanks' | 'notFound' }
const { lang, kind } = Astro.props as Props;
const d = t(lang);
const meta = d.meta[kind];
const legal = kind === 'privacy' || kind === 'terms' ? d.legal[kind] : null;
const msg = kind === 'thanks' ? d.thanks : kind === 'notFound' ? d.notFound : null;
---
<Base lang={lang} title={meta.title} description={meta.description} noindex={kind === 'thanks' || kind === 'notFound'}>
  <Header lang={lang} />
  <main id="main" class="wrap max-w-3xl py-16 sm:py-24">
    {legal && (
      <article>
        <span class="todo">{d.legal.draft}</span>
        <h1 class="mt-4 text-4xl sm:text-5xl">{legal.title}</h1>
        <p class="mt-3 text-sm text-ink-soft"><T v={d.legal.updated} /></p>
        <div class="mt-10 space-y-5 text-lg"><p><T v={legal.body} /></p></div>
        <div class="mt-12 grid gap-8 border-t border-line pt-6 text-ink-soft sm:grid-cols-2">
          <div>
            <p class="font-medium text-ink">{d.legal.company}</p>
            <p>{brand.legalName}</p>
            <p>{d.legal.address}: {brand.address}</p>
            <p>{d.legal.email}: <a href={`mailto:${brand.email}`} class="link">{brand.email}</a></p>
          </div>
          <div>
            <p class="font-medium text-ink">{d.legal.owners}</p>
            <ul class="space-y-3">
              {owners.map((o) => (
                <li><p>{o.name}</p><p>{o.address}</p><p>{d.legal.phone}: {o.phone}</p></li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    )}
    {msg && (
      <div class="text-center">
        <svg class="mx-auto text-terra" width="88" height="64" viewBox="0 0 88 64" aria-hidden="true"><rect x="2" y="2" width="84" height="60" rx="5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M3 4 L44 36 L85 4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
        <h1 class="mt-8 text-4xl sm:text-5xl">{msg.title}</h1>
        <p class="mt-5 text-lg text-ink-soft"><T v={msg.text} /></p>
        <a href={localePath(lang)} class="btn btn-primary mt-10">{msg.back}</a>
      </div>
    )}
  </main>
  <Footer lang={lang} />
</Base>
