---
// Lucide (UI) and Simple Icons (social brands), inlined at build time — no runtime JS.
import {
  ArrowRight, ArrowUpRight, Bed, Bus, CalendarPlus, Check, ChevronDown, CircleHelp, Clock, Globe, Heart, Link, Lock,
  Mail, MapPin, Menu, MessageCircle, Navigation, Plus, QrCode, Send, Shirt, Smartphone, UserPlus, Utensils, X,
} from 'lucide-static';
import { siInstagram, siPinterest, siTelegram, siTiktok, siX } from 'simple-icons';

const lucide = {
  'arrow-right': ArrowRight, 'arrow-up-right': ArrowUpRight, bed: Bed, bus: Bus, calendar: CalendarPlus, check: Check,
  'chevron-down': ChevronDown, help: CircleHelp, clock: Clock, globe: Globe, heart: Heart, link: Link, lock: Lock,
  mail: Mail, 'map-pin': MapPin, menu: Menu, message: MessageCircle, navigation: Navigation, plus: Plus, qr: QrCode,
  send: Send, shirt: Shirt, phone: Smartphone, 'user-plus': UserPlus, utensils: Utensils, close: X,
};
const brands = { instagram: siInstagram, tiktok: siTiktok, pinterest: siPinterest, telegram: siTelegram, x: siX };
export type IconName = keyof typeof lucide | keyof typeof brands;

interface Props {
  name: IconName | string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = '' } = Astro.props;

let svg: string;
if (name in brands) {
  const icon = brands[name as keyof typeof brands];
  svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor" aria-hidden="true" focusable="false" class="${cls}"><path d="${icon.path}"/></svg>`;
} else {
  svg = (lucide[name as keyof typeof lucide] ?? CircleHelp)
    .replace(/class="[^"]*"/, `class="${cls}" aria-hidden="true" focusable="false"`)
    .replace(/width="24"/, `width="${size}"`)
    .replace(/height="24"/, `height="${size}"`)
    .replace(/stroke-width="2"/, 'stroke-width="1.6"');
}
---
<Fragment set:html={svg} />
