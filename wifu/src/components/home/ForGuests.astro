---
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const g = t(lang).forGuests;
---
<section class="bg-ink py-20 text-paper lg:py-24">
  <div class="wrap">
    <p class="text-sm font-medium tracking-wide text-terra-light">{g.eyebrow}</p>
    <h2 class="h2 mt-3 max-w-2xl">{g.title}</h2>
    <dl class="mt-12 grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-paper/15">
      {g.items.map((it, i) => (
        <div class:list={['md:px-8', i === 0 && 'md:pl-0']}>
          <dt class="font-display text-2xl">{it.title}</dt>
          <dd class="mt-3 text-paper/75">{it.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
