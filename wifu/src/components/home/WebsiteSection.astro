---
import LaptopSite from '../mockups/LaptopSite.astro';
import Icon from '../Icon.astro';
import { localePath, t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const w = t(lang).website;
---
<section id="website" class="py-20 lg:py-28">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow">{w.eyebrow}</p>
        <h2 class="h2 mt-3">{w.title}</h2>
      </div>
      <p class="text-lg text-ink-soft lg:pb-1">{w.lead}</p>
    </div>

    <div class="relative mt-12 lg:mt-16" data-reveal>
      <div aria-hidden="true" class="absolute inset-x-[6%] top-[12%] -bottom-6 rounded-[2rem] bg-sage/25"></div>
      <LaptopSite lang={lang} label={w.mockupAlt} class="relative mx-auto max-w-4xl" />
    </div>

    <ul class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {w.features.map((f) => (
        <li class="flex gap-4 border-t border-line pt-5">
          <Icon name={f.icon} size={22} class="mt-1 shrink-0 text-terra" />
          <div>
            <h3 class="font-sans text-lg font-medium">{f.title}</h3>
            <p class="mt-1 text-ink-soft">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <a href={localePath(lang, 'demo')} class="link mt-10 inline-flex items-center gap-1.5">{w.link}<Icon name="arrow-right" size={16} /></a>
  </div>
</section>
