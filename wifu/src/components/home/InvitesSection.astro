---
import Icon from '../Icon.astro';
import T from '../T.astro';
import { img } from '../../lib/asset';
import { localePath, t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const v = t(lang).invites;
const channelIcons = ['message', 'mail', 'qr'];
const tilt = ['-rotate-2', 'rotate-1', '-rotate-1', 'rotate-2', '-rotate-1', 'rotate-1'];
---
<section id="invites" class="bg-paper-2/70 py-20 lg:py-28">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="eyebrow">{v.eyebrow}</p>
      <h2 class="h2 mt-3">{v.title}</h2>
      <p class="mt-5 text-lg text-ink-soft">{v.lead}</p>
    </div>
  </div>

  <!-- On phones this row scrolls sideways inside itself; the page never scrolls horizontally. -->
  <ul class="wrap mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-6 sm:grid sm:grid-cols-3 sm:gap-8 sm:overflow-visible lg:grid-cols-6 lg:gap-5" aria-label={v.eyebrow}>
    {v.designs.map((d, i) => (
      <li class="w-[58%] shrink-0 snap-center sm:w-auto">
        <figure class:list={['transition-transform duration-300 ease-(--ease-soft) hover:rotate-0 hover:-translate-y-1', tilt[i]]}>
          <img src={img(`invite-design-0${i + 1}.jpg`)} alt={d.alt} width="800" height="1120" loading="lazy" decoding="async" class="aspect-[5/7] w-full rounded-md object-cover shadow-[0_18px_30px_-18px_rgb(31_38_56/0.5)]" />
          <figcaption class="mt-3 text-center text-sm text-ink-soft">{d.name}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
  <div class="wrap">
    <p class="text-sm text-ink-soft"><T v={v.designsNote} /></p>

    <div class="mt-12 grid gap-8 border-t border-line pt-10 lg:grid-cols-[1fr_2fr] lg:items-center">
      <h3 class="text-2xl">{v.sendTitle}</h3>
      <ul class="flex flex-wrap gap-3">
        {v.channels.map((c, i) => (
          <li class="flex items-center gap-2.5 rounded-full border border-line bg-card px-4 py-2.5"><Icon name={channelIcons[i]} size={18} class="text-terra" />{c}</li>
        ))}
      </ul>
    </div>
    <a href={localePath(lang, 'demo/invite')} class="link mt-10 inline-flex items-center gap-1.5">{v.link}<Icon name="arrow-right" size={16} /></a>
  </div>
</section>
