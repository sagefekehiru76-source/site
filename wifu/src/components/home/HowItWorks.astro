---
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = t(lang).how;
---
<section id="how" class="border-y border-line bg-paper-2/60 py-20 lg:py-24">
  <div class="wrap">
    <p class="eyebrow">{h.eyebrow}</p>
    <h2 class="h2 mt-3 max-w-2xl">{h.title}</h2>
    <ol class="relative mt-14 grid gap-10 lg:grid-cols-4 lg:gap-8">
      <!-- the timeline: vertical on phones, horizontal from lg -->
      <span aria-hidden="true" class="absolute top-2 bottom-2 left-[15px] w-px border-l border-dashed border-ink/30 lg:top-[15px] lg:right-0 lg:bottom-auto lg:left-0 lg:h-px lg:w-full lg:border-t lg:border-l-0"></span>
      {h.steps.map((s, i) => (
        <li class="relative pl-14 lg:pl-0 lg:pt-14" data-reveal style={`transition-delay:${i * 90}ms`}>
          <span class="absolute top-0 left-0 grid size-8 place-items-center rounded-full border border-ink bg-paper font-display text-sm">{i + 1}</span>
          <h3 class="text-2xl">{s.title}</h3>
          <p class="mt-2 text-ink-soft">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
