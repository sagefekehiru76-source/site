---
import PhoneRsvp from '../mockups/PhoneRsvp.astro';
import RsvpDashboard from '../mockups/RsvpDashboard.astro';
import Icon from '../Icon.astro';
import { img } from '../../lib/asset';
import { localePath, t, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const r = t(lang).rsvp;
---
<section id="rsvp" class="py-20 lg:py-28">
  <div class="wrap grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div>
      <p class="eyebrow">{r.eyebrow}</p>
      <h2 class="h2 mt-3">{r.title}</h2>

      <h3 class="mt-10 font-sans text-base font-medium text-ink-soft">{r.guestTitle}</h3>
      <ol class="mt-4 space-y-3">
        {r.guestSteps.map((s, i) => (
          <li class="flex items-baseline gap-4 text-lg"><span class="font-display text-terra">{String(i + 1).padStart(2, '0')}</span>{s}</li>
        ))}
      </ol>

      <h3 class="mt-10 font-sans text-base font-medium text-ink-soft">{r.coupleTitle}</h3>
      <p class="mt-3 text-lg">{r.coupleText}</p>
      <a href={localePath(lang, 'demo#rsvp')} class="link mt-8 inline-flex items-center gap-1.5">{r.link}<Icon name="arrow-right" size={16} /></a>
    </div>

    <div class="relative" data-reveal>
      <img src={img('rsvp-couple.jpg')} alt="" width="1200" height="1500" loading="lazy" decoding="async" class="ml-auto hidden aspect-[4/5] w-[72%] rounded-[1.75rem] object-cover sm:block" />
      <div class="flex flex-col items-center gap-8 sm:block">
        <PhoneRsvp lang={lang} label={r.phoneAlt} class="sm:absolute sm:top-10 sm:left-0 sm:rotate-[-3deg]" />
        <RsvpDashboard lang={lang} label={r.dashboardAlt} class="sm:absolute sm:right-0 sm:-bottom-10 sm:w-[23rem]" />
      </div>
    </div>
  </div>
</section>
