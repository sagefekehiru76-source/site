---
// Switches data-theme on the closest .themed element. The choice is remembered in localStorage
// and can be preset with ?theme=garden in the URL.
interface Props { label: string; themes: Record<'minimal' | 'garden' | 'city', string>; class?: string }
const { label, themes, class: cls = "" } = Astro.props as Props;
const swatch = { minimal: '#faf7f2', garden: '#8c9a7d', city: '#1f2638' };
---
<div role="group" aria-label={label} class:list={['flex items-center gap-1 rounded-full border border-ink/15 bg-paper/95 p-1 text-sm text-ink shadow-[0_10px_30px_-12px_rgb(31_38_56/0.45)] backdrop-blur', cls]} data-theme-switch>
  <span class="hidden px-2 text-ink-soft sm:inline">{label}</span>
  {(Object.keys(themes) as (keyof typeof themes)[]).map((k) => (
    <button type="button" data-set-theme={k} aria-pressed={k === 'minimal' ? 'true' : 'false'} class="flex min-h-10 items-center gap-2 rounded-full px-3 py-1.5 transition-colors aria-pressed:bg-ink aria-pressed:text-paper hover:bg-paper-2 aria-pressed:hover:bg-ink">
      <span class="size-3.5 rounded-full border border-ink/25 ring-1 ring-paper/60" style={`background:${swatch[k]}`}></span>{themes[k]}
    </button>
  ))}
</div>
<script>
  const KEY = 'wifu-demo-theme';
  const valid = ['minimal', 'garden', 'city'];
  for (const sw of document.querySelectorAll<HTMLElement>('[data-theme-switch]')) {
    const target = document.querySelector<HTMLElement>('.themed');
    if (!target) continue;
    const apply = (theme: string) => {
      target.dataset.theme = theme;
      sw.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setTheme === theme)));
    };
    let initial = new URLSearchParams(location.search).get('theme');
    try { initial ||= localStorage.getItem(KEY); } catch {}
    if (initial && valid.includes(initial)) apply(initial);
    sw.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-set-theme]');
      if (!b) return;
      apply(b.dataset.setTheme!);
      try { localStorage.setItem(KEY, b.dataset.setTheme!); } catch {}
    });
  }
</script>
