---
import { mockupImages } from '../../config';
import { img } from '../../lib/asset';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang; label: string; class?: string }
const { lang, label, class: cls = '' } = Astro.props;
const m = t(lang).mockups;
const demo = t(lang).demo;
---
<div class:list={['w-full', cls]} role="img" aria-label={label}>
  <div class="rounded-t-2xl border-[7px] border-b-0 border-ink bg-ink shadow-[0_30px_60px_-30px_rgb(31_38_56/0.5)]">
    <div class="flex items-center gap-1.5 bg-ink px-2 pb-1.5">
      <span class="size-2 rounded-full bg-paper/25"></span><span class="size-2 rounded-full bg-paper/25"></span><span class="size-2 rounded-full bg-paper/25"></span>
      <span class="ml-3 hidden truncate rounded bg-paper/10 px-3 py-0.5 text-[10px] text-paper/60 sm:block">mira-and-daniel.wifu…</span>
    </div>
    <div class="aspect-[16/10] overflow-hidden bg-paper text-[clamp(7px,1.05vw,11px)] leading-snug">
      {mockupImages.websiteLaptop ? <img src={mockupImages.websiteLaptop} alt="" class="size-full object-cover" loading="lazy" decoding="async" /> : (
        <div class="flex h-full flex-col">
          <div class="flex items-center justify-between border-b border-line px-[4%] py-[1.6%]">
            <span class="font-display text-[1.25em]">M &amp; D</span>
            <span class="flex gap-[1.2em] text-ink-soft">{m.nav.map((n) => <span>{n}</span>)}</span>
          </div>
          <div class="grid flex-1 grid-cols-[1.05fr_1fr]">
            <div class="flex flex-col justify-center gap-[0.8em] px-[8%]">
              <span class="text-terra">{demo.cover.kicker}</span>
              <span class="font-display text-[2.7em] leading-[1.05]">{m.names}</span>
              <span class="text-ink-soft">{m.date} · {m.place}</span>
              <span class="mt-[0.6em] w-fit rounded-full bg-ink px-[1.4em] py-[0.6em] text-paper">{m.rsvpButton}</span>
              <div class="mt-[1em] grid grid-cols-3 gap-[0.6em] border-t border-line pt-[1em]">
                {m.schedule.map(([time, what]) => <div><span class="block font-medium text-terra">{time}</span><span class="text-ink-soft">{what}</span></div>)}
              </div>
            </div>
            <img src={img('demo-couple-cover.jpg')} alt="" width="1920" height="1280" class="size-full object-cover" loading="lazy" decoding="async" />
          </div>
        </div>
      )}
    </div>
  </div>
  <div class="relative mx-[-4%] h-3 rounded-b-xl bg-[#2b3247]"><div class="absolute top-0 left-1/2 h-1.5 w-[14%] -translate-x-1/2 rounded-b-md bg-ink/60"></div></div>
</div>
