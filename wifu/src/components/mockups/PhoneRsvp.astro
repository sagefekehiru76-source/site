---
import PhoneFrame from './PhoneFrame.astro';
import { mockupImages } from '../../config';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang; label: string; class?: string }
const { lang, label, class: cls } = Astro.props;
const f = t(lang).mockups.form;
const names = t(lang).mockups.names;
---
<PhoneFrame label={label} class={cls} image={mockupImages.rsvpPhone}>
  <div class="flex h-full flex-col px-4 pt-9 pb-4 text-[10px] leading-snug">
    <p class="text-center text-[9px] text-ink-soft">{names}</p>
    <p class="mt-1 text-center font-display text-[19px]">{f.title}</p>
    <div class="mt-4 space-y-1.5">
      <div class="flex items-center gap-2 rounded-lg border-[1.5px] border-ink bg-card px-3 py-2 font-medium"><span class="grid size-3 place-items-center rounded-full border-[1.5px] border-ink"><span class="size-1.5 rounded-full bg-ink"></span></span>{f.yes}</div>
      <div class="flex items-center gap-2 rounded-lg border border-line bg-card px-3 py-2 text-ink-soft"><span class="size-3 rounded-full border border-line"></span>{f.no}</div>
    </div>
    <div class="mt-3 flex items-center justify-between rounded-lg border border-line bg-card px-3 py-2">
      <span>{f.plusOne}</span>
      <span class="relative h-4 w-7 rounded-full bg-sage-dark"><span class="absolute top-0.5 right-0.5 size-3 rounded-full bg-card"></span></span>
    </div>
    <p class="mt-3 mb-1 text-[9px] text-ink-soft">{f.meal}</p>
    <div class="flex gap-1.5">
      {f.meals.map((meal, i) => <span class:list={['rounded-full border px-2.5 py-1', i === 1 ? 'border-terra bg-terra/10 text-terra' : 'border-line bg-card']}>{meal}</span>)}
    </div>
    <div class="mt-3 flex items-center gap-2 rounded-lg border border-line bg-card px-3 py-2">
      <span class="grid size-3 place-items-center rounded-[3px] bg-ink text-[8px] text-paper">✓</span>{f.shuttle}
    </div>
    <div class="mt-auto rounded-full bg-terra py-2 text-center text-[11px] font-medium text-paper">{f.send}</div>
  </div>
</PhoneFrame>
