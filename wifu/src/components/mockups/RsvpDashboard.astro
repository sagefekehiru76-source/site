---
import { mockupImages } from '../../config';
import { t, type Lang } from '../../i18n';
interface Props { lang: Lang; label: string; class?: string }
const { lang, label, class: cls = '' } = Astro.props;
const m = t(lang).mockups.dashboard;
// Sample numbers for the illustration only.
const stats = [
  { label: m.coming, value: 86, cls: 'bg-sage-dark' },
  { label: m.notComing, value: 9, cls: 'bg-terra' },
  { label: m.waiting, value: 23, cls: 'bg-line' },
];
const total = stats.reduce((s, x) => s + x.value, 0);
const meals = [41, 28, 17];
---
<div class:list={['w-full max-w-md rounded-2xl border border-line bg-card p-5 text-sm shadow-[0_24px_50px_-28px_rgb(31_38_56/0.45)]', cls]} role="img" aria-label={label}>
  {mockupImages.rsvpDashboard ? <img src={mockupImages.rsvpDashboard} alt="" class="w-full rounded-lg" loading="lazy" decoding="async" /> : (
    <Fragment>
      <div class="flex items-baseline justify-between">
        <p class="font-display text-xl">{m.title}</p>
        <p class="text-xs text-ink-soft">{m.sample}</p>
      </div>
      <div class="mt-4 flex h-2.5 overflow-hidden rounded-full">
        {stats.map((s) => <span class={s.cls} style={`width:${(s.value / total) * 100}%`}></span>)}
      </div>
      <dl class="mt-3 grid grid-cols-3 gap-2">
        {stats.map((s) => (
          <div><dt class="flex items-center gap-1.5 text-xs text-ink-soft"><span class:list={['size-2 rounded-full', s.cls]}></span>{s.label}</dt><dd class="font-display text-2xl">{s.value}</dd></div>
        ))}
      </dl>
      <div class="mt-4 grid grid-cols-2 gap-4 border-t border-line pt-4">
        <div>
          <p class="mb-2 text-xs text-ink-soft">{m.meals}</p>
          <ul class="space-y-1.5">
            {m.mealNames.map((n, i) => (
              <li class="grid grid-cols-[4.5rem_1fr_1.5rem] items-center gap-2 text-xs"><span class="truncate">{n}</span><span class="h-1.5 rounded-full bg-terra-light" style={`width:${(meals[i] / meals[0]) * 100}%`}></span><span class="text-right">{meals[i]}</span></li>
            ))}
          </ul>
        </div>
        <div class="space-y-2 text-xs">
          <p class="flex justify-between"><span class="text-ink-soft">{m.plusOnes}</span><span class="font-medium">14</span></p>
          <p class="flex justify-between"><span class="text-ink-soft">{m.shuttle}</span><span class="font-medium">32</span></p>
        </div>
      </div>
      <div class="mt-4 border-t border-line pt-3">
        <p class="mb-2 text-xs text-ink-soft">{m.latest}</p>
        <ul class="space-y-1.5 text-xs">
          {m.rows.map(([n, s]) => <li class="flex justify-between"><span>{n}</span><span class:list={[s.includes('+1') || !/(Wait|Bekl)/.test(s) ? 'text-sage-dark' : 'text-ink-soft']}>{s}</span></li>)}
        </ul>
      </div>
    </Fragment>
  )}
</div>
